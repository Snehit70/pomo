<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome layer for the adaptive launcher icon (themed icons, Android 13+).
  Single flat colour: the system tints it, so no gradients here. Geometry
  matches ic_launcher_foreground (r=30 arc, r=8 dot at 54,54) and stays inside
  the 72dp safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M54,24 A30,30 0 1,1 24,54"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round" />
    <path
        android:pathData="M54,46a8,8 0 1,1 0,16a8,8 0 1,1 0,-16z"
        android:fillColor="#FFFFFFFF" />
</vector>
