<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification small icon. Android renders status-bar icons as an alpha mask,
  so this must be a flat single-colour silhouette: no gradients, no opaque
  background plate, 24dp. Mirrors the launcher motif (progress arc + centre
  dot) with the same top-left gap.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M12,4.5A7.5,7.5 0 1,1 4.5,12"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.8"
        android:strokeLineCap="round" />
    <path
        android:pathData="M12,10a2,2 0 1,1 0,4a2,2 0 1,1 0,-4z"
        android:fillColor="#FFFFFFFF" />
</vector>
